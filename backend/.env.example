# Exact browser origins, comma-separated. Use explicit HTTPS origins when hosted.
CHATBOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CHATBOT_SESSION_TTL_SECONDS=1800
CHATBOT_MAX_SESSIONS=500
CHATBOT_HISTORY_LIMIT=24
# Cleanup also runs on every request.
CHATBOT_CLEANUP_INTERVAL_SECONDS=60
